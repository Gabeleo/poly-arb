# Copy to .env and fill in only what you need. All values are optional.
# Never commit .env: it is listed in .gitignore.

# Daemon API key (clients send it as the X-API-Key header). Leave empty to disable auth locally.
POLYARB_API_KEY=

# Database: SQLite by default, Postgres also supported (pip install -e ".[postgres]")
POLYARB_DATABASE_URL=sqlite:///polyarb.db

# Cross-encoder matching service (started by docker compose)
POLYARB_ENCODER_URL=http://encoder:8000

# Kalshi credentials, only needed for authenticated trading endpoints
POLYARB_KALSHI_API_KEY=
# Host path to your Kalshi RSA private key (mounted read-only into the daemon)
KALSHI_KEY_FILE=

# Telegram alerts (optional)
POLYARB_TELEGRAM_BOT_TOKEN=
POLYARB_TELEGRAM_CHAT_ID=
POLYARB_TELEGRAM_WEBHOOK_URL=

# Logging
POLYARB_LOG_LEVEL=INFO

# Grafana admin password for the local stack
GRAFANA_ADMIN_PASSWORD=change-me
